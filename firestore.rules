rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- User Profile, Encryption Keys & Vault Files ---
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Per-User App Data (notes, tasks, passwords, etc.) ---
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Transfer App (Drop) - Global Rooms ---
    // Room creator is stored in creatorUid; joiner is any auth'd user who knows the room code.
    // ICE candidate subcollections follow the same parent-doc access pattern.
    match /artifacts/{appId}/global_transfers/{roomId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
        && (resource.data.creatorUid == request.auth.uid
            || resource.data.joinerUid == request.auth.uid
            || !('joinerUid' in resource.data));  // Room not yet joined — allow any auth'd user to claim it
      allow delete: if request.auth != null
        && resource.data.creatorUid == request.auth.uid;
    }
    match /artifacts/{appId}/global_transfers/{roomId}/{sub}/{doc} {
      allow read, write: if request.auth != null
        && (get(/databases/$(database)/documents/artifacts/$(appId)/global_transfers/$(roomId)).data.creatorUid == request.auth.uid
            || get(/databases/$(database)/documents/artifacts/$(appId)/global_transfers/$(roomId)).data.joinerUid == request.auth.uid
            || !('joinerUid' in get(/databases/$(database)/documents/artifacts/$(appId)/global_transfers/$(roomId)).data));
    }

    // --- Shared Notes (public encrypted blobs) ---
    match /shared_notes/{noteId} {
      allow create: if request.auth != null;
      allow read: if true;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // --- SecureShare: Public Keys ---
    match /artifacts/{appId}/public_keys/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- SecureShare: 1:1 Chats ---
    match /artifacts/{appId}/chats/{chatId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in chatId.split('_');
    }

    // --- SecureShare: Group Chats ---
    match /artifacts/{appId}/groups/{groupId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      // Group subcollections (messages, group_members) — restricted to members
      match /messages/{msgId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/groups/$(groupId)).data.memberUids;
      }
      match /group_members/{memberId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/groups/$(groupId)).data.memberUids;
      }
    }

    // --- Per-Document Collaboration ---
    match /artifacts/{appId}/shared_docs/{shareId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberUids
        && (
          !('viewerUids' in resource.data)
          || !(request.auth.uid in resource.data.viewerUids)
        );
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      match /members/{memberId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/shared_docs/$(shareId)).data.memberUids;
      }
    }

    // --- Workspace Collaboration ---
    match /artifacts/{appId}/workspaces/{wsId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/workspaces/$(wsId)).data.memberUids;
      }

      match /{collectionName}/{document=**} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/workspaces/$(wsId)).data.memberUids;
        allow write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/workspaces/$(wsId)).data.memberUids
          && (
            !('viewerUids' in get(/databases/$(database)/documents/artifacts/$(appId)/workspaces/$(wsId)).data)
            || !(request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/workspaces/$(wsId)).data.viewerUids)
          );
      }
    }
  }
}
