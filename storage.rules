rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isUnderSizeLimit() {
      return request.resource.size < 50 * 1024 * 1024;
    }
    function isSharedDocMember(appId, shareId) {
      return firestore.exists(/databases/(default)/documents/artifacts/$(appId)/shared_docs/$(shareId)/members/$(request.auth.uid));
    }
    function isSecureshareParticipant(appId, chatId) {
      // DM chats: chatId = uid1_uid2 (sorted); check if requester's UID appears as uid1 or uid2
      return chatId.matches(request.auth.uid + '_.*')
          || chatId.matches('.*_' + request.auth.uid)
          // Group chats: check memberUids array in Firestore group doc
          || (firestore.exists(/databases/(default)/documents/artifacts/$(appId)/chats/$(chatId))
              && request.auth.uid in firestore.get(/databases/(default)/documents/artifacts/$(appId)/chats/$(chatId)).data.memberUids);
    }

    match /artifacts/{appId} {
      // 1. Personal Vaults (/users/{userId}/...)
      match /users/{userId}/{allPaths=**} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if isAuthenticated() && request.auth.uid == userId && isUnderSizeLimit();
      }

      // 2. Workspaces (/workspaces/{workspaceId}/...)
      match /workspaces/{workspaceId}/{allPaths=**} {
        allow read: if isAuthenticated() && 
                    request.auth.uid in firestore.get(/databases/(default)/documents/artifacts/$(appId)/workspaces/$(workspaceId)).data.memberUids;
        allow write: if isAuthenticated() && isUnderSizeLimit() &&
                     request.auth.uid in firestore.get(/databases/(default)/documents/artifacts/$(appId)/workspaces/$(workspaceId)).data.memberUids;
      }

      // 3. Shared Docs (/shared_docs/{shareId}/...)
      // Only collaborators listed in the Firestore members subcollection may access attachments.
      match /shared_docs/{shareId}/{allPaths=**} {
        allow read: if isAuthenticated() && isSharedDocMember(appId, shareId);
        allow write: if isAuthenticated() && isUnderSizeLimit() && isSharedDocMember(appId, shareId);
      }

      // 4. SecureShare Temporary Files (/secureshare/{chatId}/...)
      // DM participants are encoded in the chatId (uid1_uid2); group participants via Firestore.
      match /secureshare/{chatId}/{allPaths=**} {
        allow read, write: if isAuthenticated() && isUnderSizeLimit() && isSecureshareParticipant(appId, chatId);
      }

      // 5. Shared Notes Attachments (/shared_notes_files/{noteId}/...)
      // Files are AES-256-GCM encrypted with a key only in the URL fragment (never sent to Firebase).
      // Public read is intentional: same security model as Firestore shared_notes (allow read: if true).
      // Write is restricted to authenticated users to prevent anonymous upload abuse.
      // Delete is restricted to authenticated users (owner cleanup + Cloud Function TTL purge).
      match /shared_notes_files/{noteId}/{allPaths=**} {
        allow read: if true;
        allow write: if isAuthenticated() && isUnderSizeLimit();
        allow delete: if isAuthenticated();
      }

    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
