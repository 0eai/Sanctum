rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /artifacts/{appId}/users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 50 * 1024 * 1024;
    }
    match /artifacts/{appId}/{folder}/{allPaths=**} {
      allow read: if request.auth != null && folder in ['misc', 'secureshare', 'notes', 'markdown', 'research'];
      allow write: if request.auth != null && folder in ['misc', 'secureshare', 'notes', 'markdown', 'research'] && request.resource.size < 50 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
